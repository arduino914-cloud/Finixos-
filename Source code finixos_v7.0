// ============================================
// REFERENCE COUNTING
// ============================================
typedef struct refcount { int count; } refcount_t;
static inline void refcount_set(refcount_t *r, int val) { r->count = val; }
static inline void refcount_inc(refcount_t *r) { __sync_fetch_and_add(&r->count, 1); }
static inline int refcount_dec(refcount_t *r) { return __sync_fetch_and_sub(&r->count, 1) == 1; }

// ============================================
// LINKED LIST
// ============================================
struct list_head { struct list_head *next, *prev; };
#define LIST_HEAD_INIT(name) { &(name), &(name) }
#define LIST_HEAD(name) struct list_head name = LIST_HEAD_INIT(name)

static inline void INIT_LIST_HEAD(struct list_head *list) { list->next = list; list->prev = list; }
static inline void __list_add(struct list_head *new, struct list_head *prev, struct list_head *next) {
    next->prev = new; new->next = next; new->prev = prev; prev->next = new;
}
static inline void list_add(struct list_head *new, struct list_head *head) { __list_add(new, head, head->next); }
static inline void list_add_tail(struct list_head *new, struct list_head *head) { __list_add(new, head->prev, head); }
static inline void __list_del(struct list_head *prev, struct list_head *next) { prev->next = next; next->prev = prev; }
static inline void list_del(struct list_head *entry) { __list_del(entry->prev, entry->next); entry->next = NULL; entry->prev = NULL; }

#define list_entry(ptr, type, member) ((type *)((char *)(ptr) - (size_t)(&((type *)0)->member)))
#define list_for_each(pos, head) for (pos = (head)->next; pos != (head); pos = pos->next)
#define list_for_each_safe(pos, n, head) for (pos = (head)->next, n = pos->next; pos != (head); pos = n, n = pos->next)

// ============================================
// MEMORY CACHE
// ============================================
typedef struct kmem_cache {
    char name[32]; size_t obj_size; int obj_count; int max_objs;
    void **objects; int *free_list; int free_count; int lock;
} kmem_cache_t;

kmem_cache_t *user_cache, *group_cache, *firewall_rule_cache;

kmem_cache_t *kmem_cache_create(const char *name, size_t obj_size, int max_objs) {
    kmem_cache_t *cache = malloc(sizeof(kmem_cache_t));
    if (!cache) return NULL;
    strncpy(cache->name, name, 31);
    cache->obj_size = obj_size;
    cache->obj_count = 0;
    cache->max_objs = max_objs;
    cache->objects = malloc(sizeof(void*) * max_objs);
    cache->free_list = malloc(sizeof(int) * max_objs);
    cache->free_count = max_objs;
    cache->lock = 0;
    for (int i = 0; i < max_objs; i++) { cache->free_list[i] = i; cache->objects[i] = NULL; }
    return cache;
}

void *kmem_cache_alloc(kmem_cache_t *cache) {
    while (__sync_lock_test_and_set(&cache->lock, 1)) {}
    if (cache->free_count == 0) { cache->lock = 0; return NULL; }
    int idx = cache->free_list[--cache->free_count];
    if (!cache->objects[idx]) cache->objects[idx] = malloc(cache->obj_size);
    if (!cache->objects[idx]) { cache->lock = 0; return NULL; }
    memset(cache->objects[idx], 0, cache->obj_size);
    cache->obj_count++;
    cache->lock = 0;
    return cache->objects[idx];
}

void kmem_cache_free(kmem_cache_t *cache, void *obj) {
    while (__sync_lock_test_and_set(&cache->lock, 1)) {}
    for (int i = 0; i < cache->max_objs; i++) {
        if (cache->objects[i] == obj) { cache->free_list[cache->free_count++] = i; cache->obj_count--; break; }
    }
    cache->lock = 0;
}

void kmem_cache_destroy(kmem_cache_t *cache) {
    for (int i = 0; i < cache->max_objs; i++) if (cache->objects[i]) free(cache->objects[i]);
    free(cache->objects); free(cache->free_list); free(cache);
}

void *kmemdup(const void *src, size_t len) { void *p = malloc(len); if (p) memcpy(p, src, len); return p; }
char *kstrdup(const char *s) { if (!s) return NULL; size_t len = strlen(s) + 1; char *p = malloc(len); if (p) memcpy(p, s, len); return p; }

// ============================================
// USER & GROUP
// ============================================
typedef struct finix_group {
    int gid; char name[MAX_NAME]; int permissions; refcount_t refcnt; struct list_head list;
} finix_group_t;

typedef struct finix_user {
    int uid; char username[MAX_NAME]; char password_hash[MAX_NAME];
    int gid; int *groups; int ngroups; refcount_t refcnt; struct list_head list;
} finix_user_t;

struct list_head user_list, group_list;
int next_uid = 1000, next_gid = 100;
finix_user_t *current_user = NULL;

int group_search(int *groups, int ngroups, int gid) {
    for (int i = 0; i < ngroups; i++) if (groups[i] == gid) return 1;
    return 0;
}

void simple_hash(const char *input, char *output) {
    unsigned long hash = 5381; int c;
    while ((c = *input++)) hash = ((hash << 5) + hash) + c;
    sprintf(output, "%lx", hash);
}

void init_user_system(void) {
    INIT_LIST_HEAD(&user_list); INIT_LIST_HEAD(&group_list);
    
    finix_group_t *g;
    g = kmem_cache_alloc(group_cache); g->gid = next_gid++; strcpy(g->name, "wheel"); g->permissions = 2; refcount_set(&g->refcnt, 1); list_add_tail(&g->list, &group_list);
    g = kmem_cache_alloc(group_cache); g->gid = next_gid++; strcpy(g->name, "users"); g->permissions = 1; refcount_set(&g->refcnt, 1); list_add_tail(&g->list, &group_list);
    g = kmem_cache_alloc(group_cache); g->gid = next_gid++; strcpy(g->name, "guests"); g->permissions = 0; refcount_set(&g->refcnt, 1); list_add_tail(&g->list, &group_list);
    
    finix_user_t *u = kmem_cache_alloc(user_cache);
    u->uid = 0; strcpy(u->username, "root"); simple_hash("finix123", u->password_hash);
    u->gid = 100; u->ngroups = 1; u->groups = malloc(sizeof(int)); u->groups[0] = 100;
    refcount_set(&u->refcnt, 1); list_add_tail(&u->list, &user_list);
    current_user = u;
}

int authenticate_user(const char *username, const char *password) {
    char hash[MAX_NAME]; simple_hash(password, hash);
    struct list_head *pos; finix_user_t *u;
    list_for_each(pos, &user_list) {
        u = list_entry(pos, finix_user_t, list);
        if (strcmp(u->username, username) == 0 && strcmp(u->password_hash, hash) == 0) {
            current_user = u; return 1;
        }
    }
    return 0;
}

int user_has_permission(int required_perm) {
    if (!current_user) return 0;
    if (current_user->uid == 0) return 1;
    struct list_head *pos; finix_group_t *g;
    list_for_each(pos, &group_list) {
        g = list_entry(pos, finix_group_t, list);
        if (group_search(current_user->groups, current_user->ngroups, g->gid) && g->permissions >= required_perm) return 1;
    }
    return 0;
}

// ============================================
// COMMAND HISTORY
// ============================================
char *history[MAX_HISTORY];
int history_count = 0;

void add_to_history(const char *cmd) {
    if (history_count < MAX_HISTORY) history[history_count++] = kstrdup(cmd);
    else { free(history[0]); for (int i = 1; i < MAX_HISTORY; i++) history[i-1] = history[i]; history[MAX_HISTORY-1] = kstrdup(cmd); }
}

void show_history(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n📜 Riwayat Perintah:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n📜 Command History:\n" COLOR_RESET);
    for (int i = 0; i < history_count; i++) printf("%3d: %s\n", i+1, history[i]);
}

// ============================================
// ERROR RECOVERY
// ============================================
jmp_buf crash_env;
int crash_counter = 0;
time_t last_crash_time = 0;

void crash_handler(int sig) {
    time_t now = time(NULL);
    if (now - last_crash_time > 60) { crash_counter = 0; last_crash_time = now; }
    if (crash_counter++ < 5) { printf(COLOR_RED "\n⚠️ FinixOS crash detected! Restarting...\n" COLOR_RESET); longjmp(crash_env, 1); }
    else if (crash_counter == 5) { printf(COLOR_RED "\n⚠️ Too many crashes! Entering safe mode...\n" COLOR_RESET); longjmp(crash_env, 2); }
}

void setup_error_recovery(void) { signal(SIGSEGV, crash_handler); signal(SIGABRT, crash_handler); signal(SIGFPE, crash_handler); }

