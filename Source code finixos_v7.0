// ============================================
// FILE MANAGEMENT
// ============================================
void cmd_ls(char *arg) { char cmd[128]; if (arg && strlen(arg) > 0) snprintf(cmd, sizeof(cmd), "ls -la --color=auto %s | head -50", arg); else snprintf(cmd, sizeof(cmd), "ls -la --color=auto | head -50"); system(cmd); }
void cmd_pwd(void) { char cwd[MAX_PATH]; if (getcwd(cwd, sizeof(cwd))) printf("%s\n", cwd); }
void cmd_cd(char *arg) { if (!arg || strlen(arg) == 0) chdir(getenv("HOME")); else if (chdir(arg) != 0) printf(COLOR_RED "cd: %s: No such directory\n" COLOR_RESET, arg); }
void cmd_mkdir(char *arg) { if (!arg || strlen(arg) == 0) { printf(COLOR_YELLOW "Usage: mkdir <dirname>\n" COLOR_RESET); return; } if (mkdir(arg, 0755) != 0) printf(COLOR_RED "mkdir: cannot create directory '%s': %s\n" COLOR_RESET, arg, strerror(errno)); }
void cmd_rm(char *arg) { if (!arg || strlen(arg) == 0) { printf(COLOR_YELLOW "Usage: rm <file>\n" COLOR_RESET); return; } if (unlink(arg) != 0) printf(COLOR_RED "rm: cannot remove '%s': %s\n" COLOR_RESET, arg, strerror(errno)); }
void cmd_cp(char *src, char *dst) { if (!src || strlen(src) == 0 || !dst || strlen(dst) == 0) { printf(COLOR_YELLOW "Usage: cp <source> <destination>\n" COLOR_RESET); return; } char cmd[256]; snprintf(cmd, sizeof(cmd), "cp -v %s %s", src, dst); system(cmd); }
void cmd_mv(char *src, char *dst) { if (!src || strlen(src) == 0 || !dst || strlen(dst) == 0) { printf(COLOR_YELLOW "Usage: mv <source> <destination>\n" COLOR_RESET); return; } char cmd[256]; snprintf(cmd, sizeof(cmd), "mv -v %s %s", src, dst); system(cmd); }
void cmd_cat(char *arg) { if (!arg || strlen(arg) == 0) { printf(COLOR_YELLOW "Usage: cat <file>\n" COLOR_RESET); return; } FILE *f = fopen(arg, "r"); if (!f) { printf(COLOR_RED "cat: %s: No such file\n" COLOR_RESET, arg); return; } char line[512]; while (fgets(line, sizeof(line), f)) printf("%s", line); fclose(f); }

// ============================================
// LANGUAGE
// ============================================
void cmd_lang(char *arg) {
    if (!arg || strlen(arg) == 0) { if (current_lang == LANG_ID) printf("Bahasa saat ini: Indonesia\nGunakan: lang en / lang id\n"); else printf("Current language: English\nUse: lang en / lang id\n"); return; }
    if (strcmp(arg, "en") == 0) { current_lang = LANG_EN; printf(COLOR_GREEN "Language changed to English\n" COLOR_RESET); }
    else if (strcmp(arg, "id") == 0) { current_lang = LANG_ID; printf(COLOR_GREEN "Bahasa diubah ke Indonesia\n" COLOR_RESET); }
    else printf(COLOR_RED "Invalid language. Use en or id.\n" COLOR_RESET);
}

