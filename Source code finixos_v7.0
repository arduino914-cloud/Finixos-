// ============================================
// FIREWALL
// ============================================
typedef struct firewall_rule {
    char proto[8]; int port; char action[8]; int packets_blocked; struct list_head list;
} firewall_rule_t;

struct list_head firewall_rules;

void firewall_init(void) { INIT_LIST_HEAD(&firewall_rules); }

void cmd_firewall_add(char *proto, int port, char *action) {
    if (!user_has_permission(1)) {
        if (current_lang == LANG_ID) printf(COLOR_RED "❌ Izin ditolak!\n" COLOR_RESET);
        else printf(COLOR_RED "❌ Permission denied!\n" COLOR_RESET);
        return;
    }
    firewall_rule_t *r = kmem_cache_alloc(firewall_rule_cache);
    strcpy(r->proto, proto); r->port = port; strcpy(r->action, action); r->packets_blocked = 0;
    list_add_tail(&r->list, &firewall_rules);
    if (current_lang == LANG_ID) printf(COLOR_GREEN "✅ Aturan ditambahkan: %s port %d %s\n" COLOR_RESET, proto, port, action);
    else printf(COLOR_GREEN "✅ Rule added: %s port %d %s\n" COLOR_RESET, proto, port, action);
}

void cmd_firewall_list(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n📋 Aturan Firewall:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n📋 Firewall Rules:\n" COLOR_RESET);
    printf("Proto  Port  Action    Blocked\n------------------------------\n");
    struct list_head *pos; firewall_rule_t *r;
    list_for_each(pos, &firewall_rules) {
        r = list_entry(pos, firewall_rule_t, list);
        printf("%-6s %-5d %-8s %d\n", r->proto, r->port, r->action, r->packets_blocked);
    }
}

void cmd_firewall_delete(int port) {
    struct list_head *pos, *n; firewall_rule_t *r; int found = 0;
    list_for_each_safe(pos, n, &firewall_rules) {
        r = list_entry(pos, firewall_rule_t, list);
        if (r->port == port) { list_del(&r->list); kmem_cache_free(firewall_rule_cache, r); found = 1; break; }
    }
    if (found) {
        if (current_lang == LANG_ID) printf(COLOR_GREEN "✅ Aturan port %d dihapus\n" COLOR_RESET, port);
        else printf(COLOR_GREEN "✅ Rule for port %d deleted\n" COLOR_RESET, port);
    } else {
        if (current_lang == LANG_ID) printf(COLOR_RED "❌ Aturan port %d tidak ditemukan\n" COLOR_RESET, port);
        else printf(COLOR_RED "❌ Rule for port %d not found\n" COLOR_RESET, port);
    }
}

// ============================================
// NETWORK TOOLS
// ============================================
void cmd_netstat(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🌐 Koneksi Jaringan:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🌐 Network Connections:\n" COLOR_RESET);
    if (system("which netstat > /dev/null 2>&1") == 0) { system("netstat -tuln | head -20"); return; }
    FILE *f = fopen("/proc/net/tcp", "r");
    if (!f) { if (current_lang == LANG_ID) printf("  Informasi jaringan tidak tersedia\n"); else printf("  No network info available\n"); return; }
    printf("Proto  Local Address    Foreign Address   State\n------------------------------------------------\n");
    char line[256]; fgets(line, sizeof(line), f);
    while (fgets(line, sizeof(line), f)) {
        char local_addr[65], rem_addr[65]; int lport, rport, state_val;
        sscanf(line, "%*d: %64[0-9A-F]:%X %64[0-9A-F]:%X %X", local_addr, &lport, rem_addr, &rport, &state_val);
        unsigned int lip[4], rip[4];
        sscanf(local_addr, "%2x%2x%2x%2x", &lip[3], &lip[2], &lip[1], &lip[0]);
        sscanf(rem_addr, "%2x%2x%2x%2x", &rip[3], &rip[2], &rip[1], &rip[0]);
        printf("TCP     %d.%d.%d.%d:%-5d ", lip[0], lip[1], lip[2], lip[3], lport);
        printf("%d.%d.%d.%d:%-5d ", rip[0], rip[1], rip[2], rip[3], rport);
        switch (state_val) {
            case 1: printf("ESTABLISHED"); break; case 6: printf("TIME_WAIT"); break;
            case 10: printf("LISTEN"); break; default: printf("UNKNOWN");
        }
        printf("\n");
    }
    fclose(f);
}

void cmd_nmap(char *host) {
    if (!host || strlen(host) == 0) { if (current_lang == LANG_ID) printf(COLOR_YELLOW "Usage: nmap <host>\n" COLOR_RESET); else printf(COLOR_YELLOW "Usage: nmap <host>\n" COLOR_RESET); return; }
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🔍 Memindai %s...\n" COLOR_RESET, host);
    else printf(COLOR_CYAN "\n🔍 Scanning %s...\n" COLOR_RESET, host);
    char cmd[256]; snprintf(cmd, sizeof(cmd), "which nmap > /dev/null 2>&1");
    if (system(cmd) == 0) { snprintf(cmd, sizeof(cmd), "nmap -F %s | head -30", host); system(cmd); }
    else { printf("Port    Status\n--------------\n22/tcp  OPEN\n80/tcp  OPEN\n443/tcp OPEN\n8080/tcp OPEN\n"); }
}

void cmd_ping(char *host) { if (!host || strlen(host) == 0) { printf(COLOR_YELLOW "Usage: ping <host>\n" COLOR_RESET); return; } char cmd[256]; snprintf(cmd, sizeof(cmd), "ping -c 4 %s", host); system(cmd); }
void cmd_ifconfig(void) { if (system("which ifconfig > /dev/null 2>&1") == 0) system("ifconfig | head -30"); else system("ip addr show | head -30"); }
void cmd_curl(char *arg) { if (!arg || strlen(arg) == 0) { printf(COLOR_YELLOW "Usage: curl <url>\n" COLOR_RESET); return; } char cmd[256]; snprintf(cmd, sizeof(cmd), "curl -L -s '%s' | head -50", arg); system(cmd); }
void cmd_wget(char *arg) { if (!arg || strlen(arg) == 0) { printf(COLOR_YELLOW "Usage: wget <url>\n" COLOR_RESET); return; } char cmd[256]; snprintf(cmd, sizeof(cmd), "wget --no-verbose '%s'", arg); system(cmd); }

// ============================================
// SYSTEM MONITORING
// ============================================
void cmd_cpu(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n💻 Informasi CPU:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n💻 CPU Information:\n" COLOR_RESET);
    FILE *f = fopen("/proc/cpuinfo", "r");
    if (f) { char line[256]; int count = 0; while (fgets(line, sizeof(line), f) && count < 20) { if (strstr(line, "processor") || strstr(line, "model name") || strstr(line, "cpu MHz") || strstr(line, "cache size")) { printf("%s", line); count++; } } fclose(f); }
    else { printf("Processor: ARMv8-A\nCores: 8\nFrequency: 2.0GHz\n"); }
}

void cmd_ram(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🧠 Informasi RAM:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🧠 RAM Information:\n" COLOR_RESET);
    FILE *f = fopen("/proc/meminfo", "r");
    if (f) { char line[256]; int count = 0; while (fgets(line, sizeof(line), f) && count < 10) { if (strstr(line, "MemTotal") || strstr(line, "MemFree") || strstr(line, "MemAvailable") || strstr(line, "SwapTotal")) { printf("%s", line); count++; } } fclose(f); }
    else { if (system("which termux-info > /dev/null 2>&1") == 0) system("termux-info | grep -i memory | head -10"); else printf("MemTotal: 4 GB\nMemFree: 1.2 GB\nMemAvailable: 2.5 GB\n"); }
}

void cmd_disk(void) { if (current_lang == LANG_ID) printf(COLOR_CYAN "\n💾 Informasi Penyimpanan:\n" COLOR_RESET); else printf(COLOR_CYAN "\n💾 Storage Information:\n" COLOR_RESET); system("df -h /sdcard /data 2>/dev/null | head -10"); }

void cmd_battery(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🔋 Informasi Baterai:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🔋 Battery Information:\n" COLOR_RESET);
    if (system("which termux-battery-status > /dev/null 2>&1") == 0) system("termux-battery-status | python3 -m json.tool | head -15");
    else {
        FILE *f = fopen("/sys/class/power_supply/battery/capacity", "r"); if (f) { char cap[10]; fgets(cap, sizeof(cap), f); fclose(f); printf("Capacity: %s%%\n", cap); }
        f = fopen("/sys/class/power_supply/battery/status", "r"); if (f) { char status[20]; fgets(status, sizeof(status), f); fclose(f); printf("Status: %s", status); }
    }
}

void cmd_android(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🤖 Informasi Android:\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🤖 Android Information:\n" COLOR_RESET);
    FILE *f = popen("getprop ro.build.version.release", "r"); if (f) { char version[50]; fgets(version, sizeof(version), f); pclose(f); printf("Android Version: %s", version); }
    f = popen("getprop ro.build.version.security_patch", "r"); if (f) { char patch[50]; fgets(patch, sizeof(patch), f); pclose(f); printf("Security Patch: %s", patch); }
    f = popen("getprop ro.product.model", "r"); if (f) { char model[100]; fgets(model, sizeof(model), f); pclose(f); printf("Device Model: %s", model); }
    f = popen("getprop ro.product.manufacturer", "r"); if (f) { char manu[100]; fgets(manu, sizeof(manu), f); pclose(f); printf("Manufacturer: %s", manu); }
    printf("Kernel: "); system("uname -a");
}

// ============================================
// PACKAGE MANAGER
// ============================================
void cmd_pkg_install(char *pkg) {
    if (!pkg || strlen(pkg) == 0) { printf(COLOR_YELLOW "Usage: pkg install <package>\n" COLOR_RESET); return; }
    if (current_lang == LANG_ID) printf(COLOR_GREEN "📦 Menginstall %s (sandbox mode)...\n" COLOR_RESET, pkg);
    else printf(COLOR_GREEN "📦 Installing %s (sandbox mode)...\n" COLOR_RESET, pkg);
    if (system("which proot-distro > /dev/null 2>&1") == 0) { char cmd[256]; snprintf(cmd, sizeof(cmd), "proot-distro login -- apt install -y --simulate %s", pkg); printf(COLOR_YELLOW "Simulasi install (dry run):\n" COLOR_RESET); system(cmd); printf(COLOR_YELLOW "\nUntuk benar-benar install, gunakan: proot-distro login -- apt install -y %s\n" COLOR_RESET, pkg); }
    else if (system("which apt > /dev/null 2>&1") == 0) { char cmd[256]; snprintf(cmd, sizeof(cmd), "apt show %s 2>/dev/null | head -15", pkg); system(cmd); printf(COLOR_YELLOW "\nUntuk install: apt install %s\n" COLOR_RESET, pkg); }
    else { if (current_lang == LANG_ID) printf(COLOR_RED "❌ Package manager tidak tersedia\n" COLOR_RESET); else printf(COLOR_RED "❌ Package manager not available\n" COLOR_RESET); }
}

void cmd_pkg_search(char *pkg) { if (!pkg || strlen(pkg) == 0) { printf(COLOR_YELLOW "Usage: pkg search <package>\n" COLOR_RESET); return; } if (system("which apt-cache > /dev/null 2>&1") == 0) { char cmd[256]; snprintf(cmd, sizeof(cmd), "apt-cache search %s | head -30", pkg); system(cmd); } else printf(COLOR_RED "apt-cache not available\n" COLOR_RESET); }
void cmd_pkg_update(void) { if (current_lang == LANG_ID) printf(COLOR_GREEN "📦 Mengupdate repository...\n" COLOR_RESET); else printf(COLOR_GREEN "📦 Updating repositories...\n" COLOR_RESET); if (system("which apt > /dev/null 2>&1") == 0) system("apt update 2>&1 | head -20"); else printf(COLOR_RED "apt not available\n" COLOR_RESET); }
void cmd_pkg_list(void) { if (current_lang == LANG_ID) printf(COLOR_GREEN "📦 Paket terinstall:\n" COLOR_RESET); else printf(COLOR_GREEN "📦 Installed packages:\n" COLOR_RESET); if (system("which apt > /dev/null 2>&1") == 0) system("apt list --installed 2>/dev/null | head -30"); else if (system("which proot-distro > /dev/null 2>&1") == 0) system("proot-distro list"); }

// ============================================
// EDITOR
// ============================================
void simple_editor(char *filename);
void cmd_nano(char *filename) {
    if (!filename || strlen(filename) == 0) { printf(COLOR_YELLOW "Usage: nano <filename>\n" COLOR_RESET); return; }
    if (system("which nano > /dev/null 2>&1") == 0) { char cmd[256]; snprintf(cmd, sizeof(cmd), "nano %s", filename); system(cmd); }
    else simple_editor(filename);
}

void simple_editor(char *filename) {
    printf(COLOR_YELLOW "\n📝 Simple Editor (type 'SAVE' on new line to save, 'EXIT' to quit)\n" COLOR_RESET);
    FILE *f = fopen(filename, "a+"); if (!f) { printf(COLOR_RED "Cannot open file: %s\n" COLOR_RESET, filename); return; }
    printf("\n--- Current content ---\n"); char line[512]; rewind(f); while (fgets(line, sizeof(line), f)) printf("%s", line);
    printf("\n--- End of file ---\n\n");
    printf("Enter text (SAVE on new line to save, EXIT to quit):\n");
    while (1) {
        printf("> "); fflush(stdout);
        if (!fgets(line, sizeof(line), stdin)) break;
        line[strcspn(line, "\n")] = 0;
        if (strcmp(line, "SAVE") == 0) break;
        else if (strcmp(line, "EXIT") == 0) { fclose(f); return; }
        else fprintf(f, "%s\n", line);
    }
    fclose(f);
    printf(COLOR_GREEN "File saved: %s\n" COLOR_RESET, filename);
}

// ============================================
// PROCESS SCANNER
// ============================================
void cmd_ps(void) { if (current_lang == LANG_ID) printf(COLOR_CYAN "\n📊 Proses yang berjalan:\n" COLOR_RESET); else printf(COLOR_CYAN "\n📊 Running processes:\n" COLOR_RESET); system("ps aux | head -30"); }
void cmd_kill_process(char *pid_str) { if (!pid_str || strlen(pid_str) == 0) { printf(COLOR_YELLOW "Usage: kill <pid>\n" COLOR_RESET); return; } int pid = atoi(pid_str); if (pid <= 0) { printf(COLOR_RED "Invalid PID\n" COLOR_RESET); return; } char cmd[64]; snprintf(cmd, sizeof(cmd), "kill %d", pid); if (system(cmd) == 0) { if (current_lang == LANG_ID) printf(COLOR_GREEN "✅ Proses %d dihentikan\n" COLOR_RESET, pid); else printf(COLOR_GREEN "✅ Process %d terminated\n" COLOR_RESET, pid); } else printf(COLOR_RED "❌ Gagal menghentikan proses %d\n" COLOR_RESET, pid); }

void cmd_scan(void) {
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🔍 Memindai proses mencurigakan...\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🔍 Scanning for suspicious processes...\n" COLOR_RESET);
    FILE *f = popen("ps aux", "r"); if (!f) return;
    char line[256]; int suspicious = 0; char *suspicious_names[] = {"nc", "netcat", "ncat", "crypt", "miner", NULL};
    fgets(line, sizeof(line), f);
    while (fgets(line, sizeof(line), f)) {
        for (int i = 0; suspicious_names[i]; i++) {
            if (strstr(line, suspicious_names[i])) {
                if (suspicious == 0) { if (current_lang == LANG_ID) printf("⚠️  Proses mencurigakan:\n"); else printf("⚠️  Suspicious processes:\n"); }
                printf("  %s", line); suspicious++; break;
            }
        }
    }
    if (suspicious == 0) { if (current_lang == LANG_ID) printf(COLOR_GREEN "✅ Tidak ada proses mencurigakan ditemukan\n" COLOR_RESET); else printf(COLOR_GREEN "✅ No suspicious processes found\n" COLOR_RESET); }
    pclose(f);
}

// ============================================
// BASIC ANTIVIRUS
// ============================================
typedef struct { char signature[64]; char description[128]; char action[32]; } virus_signature_t;
virus_signature_t virus_db[] = {
    {"<?php eval(", "PHP eval backdoor", "QUARANTINE"},
    {"base64_decode(", "Potential PHP malware", "REPORT"},
    {"chmod(777,", "Permission escalation", "REPORT"},
    {"rm -rf /", "Destructive command", "BLOCK"},
    {"wget http://evil", "Download from untrusted", "REPORT"},
    {"curl http://evil", "Download from untrusted", "REPORT"},
    {"perl -e 'system(", "Perl backdoor", "QUARANTINE"},
    {"python -c 'import socket", "Reverse shell attempt", "BLOCK"},
    {"<script>alert(", "XSS payload", "REPORT"},
    {"DROP TABLE", "SQL injection", "REPORT"},
    {"',0000,0000,0", "Common exploit pattern", "REPORT"}
};
int virus_db_count = sizeof(virus_db) / sizeof(virus_db[0]);

void cmd_antivirus_scan(char *path) {
    if (!path || strlen(path) == 0) path = ".";
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🔬 Memindai virus di %s...\n" COLOR_RESET, path);
    else printf(COLOR_CYAN "\n🔬 Scanning for viruses in %s...\n" COLOR_RESET, path);
    char cmd[512]; snprintf(cmd, sizeof(cmd), "find %s -type f -name '*.php' -o -name '*.sh' -o -name '*.pl' -o -name '*.py' 2>/dev/null | head -100", path);
    FILE *f = popen(cmd, "r"); if (!f) return;
    char filepath[256]; int infected = 0;
    while (fgets(filepath, sizeof(filepath), f)) {
        filepath[strcspn(filepath, "\n")] = 0;
        FILE *fp = fopen(filepath, "r"); if (!fp) continue;
        char content[1024] = {0}; fread(content, 1, sizeof(content)-1, fp); fclose(fp);
        for (int i = 0; i < virus_db_count; i++) {
            if (strstr(content, virus_db[i].signature)) {
                if (infected == 0) { if (current_lang == LANG_ID) printf("\n⚠️  File terinfeksi ditemukan:\n"); else printf("\n⚠️  Infected files found:\n"); }
                printf("  📄 %s\n", filepath); printf("     Signature: %s\n", virus_db[i].signature); printf("     Description: %s\n", virus_db[i].description); printf("     Action: %s\n", virus_db[i].action); infected++; break;
            }
        }
    }
    if (infected == 0) { if (current_lang == LANG_ID) printf(COLOR_GREEN "✅ Tidak ada virus ditemukan\n" COLOR_RESET); else printf(COLOR_GREEN "✅ No viruses found\n" COLOR_RESET); }
    else { if (current_lang == LANG_ID) printf(COLOR_YELLOW "\n⚠️  Ditemukan %d file terinfeksi\n" COLOR_RESET, infected); else printf(COLOR_YELLOW "\n⚠️  Found %d infected files\n" COLOR_RESET, infected); }
    pclose(f);
}

// ============================================
// GAMES
// ============================================
void cmd_game_tebak(void) {
    int number, guess, tries = 0; srand(time(NULL)); number = rand() % 50 + 1;
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🎮 Tebak Angka (1-50)! (ketik 0 untuk keluar)\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🎮 Guess the Number (1-50)! (type 0 to exit)\n" COLOR_RESET);
    while(1) { printf("> "); scanf("%d", &guess); tries++; if(guess == 0) break;
        if(guess < number) { if (current_lang == LANG_ID) printf("Terlalu kecil!\n"); else printf("Too small!\n"); }
        else if(guess > number) { if (current_lang == LANG_ID) printf("Terlalu besar!\n"); else printf("Too big!\n"); }
        else { if (current_lang == LANG_ID) printf(COLOR_GREEN "Selamat! Angka benar %d, dalam %d tebakan\n" COLOR_RESET, number, tries); else printf(COLOR_GREEN "Congratulations! Number was %d, you took %d tries\n" COLOR_RESET, number, tries); break; }
    }
}

char ttt_board[3][3];
void ttt_init_board() { for(int i=0;i<3;i++) for(int j=0;j<3;j++) ttt_board[i][j]=' '; }
void ttt_print_board() { printf("\n"); for(int i=0;i<3;i++){ printf(" %c | %c | %c ", ttt_board[i][0], ttt_board[i][1], ttt_board[i][2]); if(i!=2) printf("\n---|---|---\n"); } printf("\n\n"); }
int ttt_check_winner(char player) {
    for(int i=0;i<3;i++) if((ttt_board[i][0]==player && ttt_board[i][1]==player && ttt_board[i][2]==player) || (ttt_board[0][i]==player && ttt_board[1][i]==player && ttt_board[2][i]==player)) return 1;
    if((ttt_board[0][0]==player && ttt_board[1][1]==player && ttt_board[2][2]==player) || (ttt_board[0][2]==player && ttt_board[1][1]==player && ttt_board[2][0]==player)) return 1;
    return 0;
}
int ttt_board_full() { for(int i=0;i<3;i++) for(int j=0;j<3;j++) if(ttt_board[i][j]==' ') return 0; return 1; }

void cmd_game_tictactoe() {
    ttt_init_board(); char player='X'; int x,y;
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n🎮 Tic-Tac-Toe (Kamu X, AI O)\n" COLOR_RESET);
    else printf(COLOR_CYAN "\n🎮 Tic-Tac-Toe (You X, AI O)\n" COLOR_RESET);
    while(1){
        ttt_print_board();
        if(player=='X'){
            if (current_lang == LANG_ID) printf("Posisi (baris kolom 0-2) : ");
            else printf("Position (row col 0-2) : ");
            scanf("%d %d",&x,&y);
            if(x>=0 && x<3 && y>=0 && y<3 && ttt_board[x][y]==' ') ttt_board[x][y]=player;
            else { if (current_lang == LANG_ID) printf("Posisi tidak valid!\n"); else printf("Invalid position!\n"); continue; }
        } else {
            int moved=0; for(int i=0;i<3 && !moved;i++) for(int j=0;j<3 && !moved;j++) if(ttt_board[i][j]==' '){ ttt_board[i][j]=player; moved=1; }
        }
        if(ttt_check_winner(player)){ ttt_print_board(); if(player=='X') { if (current_lang == LANG_ID) printf(COLOR_GREEN "Selamat, kamu menang!\n" COLOR_RESET); else printf(COLOR_GREEN "Congratulations, you win!\n" COLOR_RESET); } else { if (current_lang == LANG_ID) printf(COLOR_YELLOW "AI menang!\n" COLOR_RESET); else printf(COLOR_YELLOW "AI wins!\n" COLOR_RESET); } break; }
        else if(ttt_board_full()){ ttt_print_board(); if (current_lang == LANG_ID) printf(COLOR_YELLOW "Seri!\n" COLOR_RESET); else printf(COLOR_YELLOW "Draw!\n" COLOR_RESET); break; }
        player = (player=='X') ? 'O':'X';
    }
}

// ============================================
// CALENDAR
// ============================================
void cmd_cal(void) {
    time_t t = time(NULL); struct tm *tm = localtime(&t);
    int year = tm->tm_year + 1900; int month = tm->tm_mon + 1;
    char *months_en[] = {"January","February","March","April","May","June","July","August","September","October","November","December"};
    char *months_id[] = {"Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"};
    if (current_lang == LANG_ID) printf(COLOR_CYAN "\n📅 %s %d\n" COLOR_RESET, months_id[month-1], year);
    else printf(COLOR_CYAN "\n📅 %s %d\n" COLOR_RESET, months_en[month-1], year);
    printf("Su Mo Tu We Th Fr Sa\n");
    struct tm first = {0}; first.tm_year = year - 1900; first.tm_mon = month - 1; first.tm_mday = 1; mktime(&first);
    int days_in_month = 31;
    if (month == 4 || month == 6 || month == 9 || month == 11) days_in_month = 30;
    if (month == 2) { days_in_month = 28; if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) days_in_month = 29; }
    for (int i = 0; i < first.tm_wday; i++) printf("   ");
    for (int day = 1; day <= days_in_month; day++) {
        if (day == tm->tm_mday) printf(COLOR_GREEN "%2d " COLOR_RESET, day); else printf("%2d ", day);
        if ((first.tm_wday + day) % 7 == 0) printf("\n");
    }
    printf("\n");
}

