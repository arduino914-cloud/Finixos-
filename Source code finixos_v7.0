// ============================================
// MAIN
// ============================================
int main(int argc, char **argv) {
    char input[MAX_LINE], cmd[64], arg1[MAX_PATH], arg2[MAX_PATH], *args[10];
    if (setjmp(crash_env) != 0) printf(COLOR_YELLOW "\nFinixOS recovered from crash\n" COLOR_RESET);
    setup_error_recovery();
    user_cache = kmem_cache_create("user_cache", sizeof(finix_user_t), MAX_USERS);
    group_cache = kmem_cache_create("group_cache", sizeof(finix_group_t), MAX_GROUPS);
    firewall_rule_cache = kmem_cache_create("firewall_rule", sizeof(firewall_rule_t), 128);
    init_user_system(); firewall_init(); boot_screen();
    char username[MAX_NAME], password[MAX_NAME];
    printf("\nFinixOS v7.0 Login\n");
    while(1) { printf("Username: "); scanf("%s", username); printf("Password: "); scanf("%s", password); if (authenticate_user(username, password)) { printf(COLOR_GREEN "\nWelcome, %s!\n" COLOR_RESET, username); break; } else printf(COLOR_RED "Invalid username or password\n" COLOR_RESET); }
    int c; while ((c = getchar()) != '\n' && c != EOF);
    while (1) {
        char prompt[128], cwd[MAX_PATH];
        if (getcwd(cwd, sizeof(cwd))) { char *home = getenv("HOME"); if (home && strstr(cwd, home) == cwd) snprintf(prompt, sizeof(prompt), "~%s", cwd + strlen(home)); else snprintf(prompt, sizeof(prompt), "%s", cwd); } else strcpy(prompt, "?");
        time_t t = time(NULL); struct tm tm = *localtime(&t);
        printf(COLOR_CYAN "\n%s@FinixOS v7.0 %02d:%02d:%02d [%s]> " COLOR_RESET, current_user->username, tm.tm_hour, tm.tm_min, tm.tm_sec, prompt); fflush(stdout);
        if (!fgets(input, sizeof(input), stdin)) break;
        input[strcspn(input, "\n")] = 0; if (strlen(input) == 0) continue;
        add_to_history(input);
        int arg_count = 0; char *token = strtok(input, " ");
        while (token && arg_count < 10) { args[arg_count++] = token; token = strtok(NULL, " "); }
        if (arg_count == 0) continue;
        strcpy(cmd, args[0]); if (arg_count > 1) strcpy(arg1, args[1]); else arg1[0] = '\0'; if (arg_count > 2) strcpy(arg2, args[2]); else arg2[0] = '\0';
        if (strcmp(cmd, "help") == 0) cmd_help();
        else if (strcmp(cmd, "lang") == 0) cmd_lang(arg1);
        else if (strcmp(cmd, "exit") == 0) { printf(COLOR_GREEN "Shutting down...\n" COLOR_RESET); break; }
        else if (strcmp(cmd, "clear") == 0) system("clear");
        else if (strcmp(cmd, "about") == 0) cmd_about();
        else if (strcmp(cmd, "history") == 0) show_history();
        else if (strcmp(cmd, "ls") == 0) cmd_ls(arg1);
        else if (strcmp(cmd, "pwd") == 0) cmd_pwd();
        else if (strcmp(cmd, "cd") == 0) cmd_cd(arg1);
        else if (strcmp(cmd, "mkdir") == 0) cmd_mkdir(arg1);
        else if (strcmp(cmd, "rm") == 0) cmd_rm(arg1);
        else if (strcmp(cmd, "cp") == 0) cmd_cp(arg1, arg2);
        else if (strcmp(cmd, "mv") == 0) cmd_mv(arg1, arg2);
        else if (strcmp(cmd, "cat") == 0) cmd_cat(arg1);
        else if (strcmp(cmd, "nano") == 0) cmd_nano(arg1);
        else if (strcmp(cmd, "cpu") == 0) cmd_cpu();
        else if (strcmp(cmd, "ram") == 0) cmd_ram();
        else if (strcmp(cmd, "disk") == 0) cmd_disk();
        else if (strcmp(cmd, "os") == 0) system("uname -a");
        else if (strcmp(cmd, "device") == 0) { system("uname -m"); system("cat /proc/version | head -1"); }
        else if (strcmp(cmd, "battery") == 0) cmd_battery();
        else if (strcmp(cmd, "android") == 0) cmd_android();
        else if (strcmp(cmd, "time") == 0) { time_t t = time(NULL); printf("%s", ctime(&t)); }
        else if (strcmp(cmd, "netstat") == 0) cmd_netstat();
        else if (strcmp(cmd, "nmap") == 0) cmd_nmap(arg1);
        else if (strcmp(cmd, "ping") == 0) cmd_ping(arg1);
        else if (strcmp(cmd, "ifconfig") == 0) cmd_ifconfig();
        else if (strcmp(cmd, "curl") == 0) cmd_curl(arg1);
        else if (strcmp(cmd, "wget") == 0) cmd_wget(arg1);
        else if (strcmp(cmd, "firewall") == 0) {
            if (strcmp(arg1, "add") == 0) { char proto[8]; int port; char action[8]; if (arg_count >= 4) { strcpy(proto, arg2); port = atoi(args[3]); if (arg_count >= 5) strcpy(action, args[4]); else strcpy(action, "allow"); cmd_firewall_add(proto, port, action); } else printf("Usage: firewall add <proto> <port> [allow|deny]\n"); }
            else if (strcmp(arg1, "list") == 0) cmd_firewall_list();
            else if (strcmp(arg1, "delete") == 0) { if (arg_count >= 3) cmd_firewall_delete(atoi(arg2)); else printf("Usage: firewall delete <port>\n"); }
            else printf("Usage: firewall <add|list|delete>\n");
        }
        else if (strcmp(cmd, "scan") == 0) cmd_scan();
        else if (strcmp(cmd, "antivirus") == 0) cmd_antivirus_scan(arg1);
        else if (strcmp(cmd, "ps") == 0) cmd_ps();
        else if (strcmp(cmd, "kill") == 0) cmd_kill_process(arg1);
        else if (strcmp(cmd, "pkg") == 0) {
            if (strcmp(arg1, "install") == 0) cmd_pkg_install(arg2);
            else if (strcmp(arg1, "search") == 0) cmd_pkg_search(arg2);
            else if (strcmp(arg1, "update") == 0) cmd_pkg_update();
            else if (strcmp(arg1, "list") == 0) cmd_pkg_list();
            else printf("Usage: pkg <install|search|update|list>\n");
        }
        else if (strcmp(cmd, "cal") == 0) cmd_cal();
        else if (strcmp(cmd, "pray") == 0) cmd_pray();
        else if (strcmp(cmd, "game") == 0) cmd_game_tebak();
        else if (strcmp(cmd, "tic") == 0) cmd_game_tictactoe();
        else { if (current_lang == LANG_ID) printf(COLOR_RED "Perintah tidak dikenal: %s\nKetik 'help' untuk bantuan\n" COLOR_RESET, cmd); else printf(COLOR_RED "Unknown command: %s\nType 'help' for available commands\n" COLOR_RESET, cmd); }
    }
    for (int i = 0; i < history_count; i++) free(history[i]);
    kmem_cache_destroy(user_cache); kmem_cache_destroy(group_cache); kmem_cache_destroy(firewall_rule_cache);
    return 0;
}
